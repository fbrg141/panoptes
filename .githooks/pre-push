#!/bin/sh
# Runs every check before a push, so a red CI run is caught locally first.
# CI runs the same `pnpm check` on every pull request. Skip once with
# `git push --no-verify`.

# Apple's /usr/bin/git sets SDKROOT for its hooks, which can point the Rust
# linker at a Command Line Tools SDK that does not match the selected Xcode.
unset SDKROOT

# Git GUIs and editors may not load the shell profile that puts rustup's
# cargo on PATH.
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH"

# During a push, git sets GIT_DIR (and friends) to the repository being pushed.
# The Rust tests shell out to git inside temporary fixture repositories; a
# leaked GIT_DIR would redirect those commands at the real repository instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY

exec pnpm check
